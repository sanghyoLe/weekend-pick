# Leave empty to run the clearly labeled, fictional preview catalogue.
DATABASE_URL=
# auto: Neon when DATABASE_URL exists; demo: always use preview fixtures.
DATA_MODE=auto
# PublicDataPortal decoding (plain) service key; encoded keys are also accepted.
TOUR_API_KEY=
# Protects /api/cron/sync. Generate locally: openssl rand -hex 32
CRON_SECRET=
# All requests and retries count toward this per-KST-day budget.
TOUR_DAILY_BUDGET=500
# Optional canonical origin for metadata. Share links use the browser origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
